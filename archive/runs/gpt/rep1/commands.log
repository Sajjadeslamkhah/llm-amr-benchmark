{"cmd": "/bin/zsh -lc \"python3 - <<'PY'\nimport csv,glob\nfor p in sorted(glob.glob('output/amrfinder/ISO_*.tsv')):\n if '.mutations.' in p: continue\n print(p)\n for r in csv.DictReader(open(p),delimiter='\\\\t'):\n  if r['Type']=='AMR': print(r['Element symbol'],r['Subclass'],r['% Coverage of reference'])\nPY\"", "exit_code": 0, "stdout": "output/amrfinder/ISO_051.tsv\ncatA1 CHLORAMPHENICOL 100.00\ntet(A) TETRACYCLINE 100.00\npmrB_V161G COLISTIN 100.00\nmph(B) ERYTHROMYCIN/SPIRAMYCIN/TELITHROMYCIN 100.00\nsul1 SULFONAMIDE 100.00\naadA1 STREPTOMYCIN 100.00\ndfrA1 TRIMETHOPRIM 100.00\naph(6)-Id STREPTOMYCIN 100.00\naph(3'')-Ib STREPTOMYCIN 100.00\nsul2 SULFONAMIDE 100.00\nblaTEM-1 BETA-LACTAM 100.00\noutput/amrfinder/ISO_052.tsv\nsul2 SULFONAMIDE 100.00\naph(3'')-Ib STREPTOMYCIN 100.00\naph(6)-Id STREPTOMYCIN 100.00\ndfrA7 TRIMETHOPRIM 100.00\nsul1 SULFONAMIDE 100.00\ntet(B) TETRACYCLINE 100.00\nuhpT_E350Q FOSFOMYCIN 100.00\ngyrA_S83L QUINOLONE 99.66\nblaTEM-1 BETA-LACTAM 100.00\noutput/amrfinder/ISO_053.tsv\naph(6)-Id STREPTOMYCIN 87.41\nblaTEM-1 BETA-LACTAM 100.00\naph(3'')-Ib STREPTOMYCIN 100.00\nsul2 SULFONAMIDE 100.00\nmarR_S3N AMPICILLIN/CHLORAMPHENICOL/QUINOLONE/RIFAMPIN/TETRACYCLINE 100.00\noutput/amrfinder/ISO_054.tsv\nmarR_S3N AMPICILLIN/CHLORAMPHENICOL/QUINOLONE/RIFAMPIN/TETRACYCLINE 100.00\n", "stderr": "", "tool": "command_execution", "source": "events.jsonl", "call_id": "item_19", "key_path": "item", "batch": "batch_006"}
{"cmd": "/bin/zsh -lc \"cat > output/make_predictions.py <<'PY'\nimport csv\nfrom pathlib import Path\n\nantibiotics=Path('data/antibiotics.txt').read_text().splitlines()\nall_calls=[]\nfor genome in sorted(Path('data/genomes').glob('*.fasta')):\n    isolate=genome.stem\n    rows=list(csv.DictReader(open(f'output/amrfinder/{isolate}.tsv'),delimiter='\\\\t'))\n    rows=[r for r in rows if r['Type']=='AMR']\n    good=[r for r in rows if float(r['% Coverage of reference'])>=90 and 'PARTIAL' not in r['Method'] and 'INTERNAL_STOP' not in r['Method']]\n    for drug in antibiotics:\n        hits=[]; uncertain=[]\n        for r in good:\n            g=r['Element symbol']; name=r['Element name'].lower(); sub=r['Subclass'].upper()\n            if drug=='ampicillin' and (g.startswith('bla') or 'AMPICILLIN' in sub): hits.append(g)\n            elif drug=='cefotaxime' and (g.startswith(('blaCTX-M','blaCMY','blaDHA','blaFOX','blaMOX','blaACC','blaACT','blaMIR','blaKPC','blaNDM','blaVIM','blaIMP')) or 'extended-spectrum' in name or 'CEFotaxime'.upper() in sub): hits.append(g)\n            elif drug=='meropenem' and (g.startswith(('blaKPC','blaNDM','blaVIM','blaIMP','blaOXA-48','blaOXA-181','blaOXA-232')) or 'carbapenem' in name or 'MEROPENEM' in sub): hits.append(g)\n            elif drug=='gentamicin' and ('GENTAMICIN' in sub or g.startswith(('armA','rmt','npmA'))): hits.append(g)\n            elif drug=='trimethoprim/sulfamethoxazole' and ('TRIMETHOPRIM' in sub or 'SULFONAMIDE' in sub): hits.append(g)\n            elif drug=='ciprofloxacin' and ('QUINOLONE' in sub or 'CIPROFLOXACIN' in sub): uncertain.append(g)\n        if drug=='ciprofloxacin':\n            gyr=[g for g in uncertain if g.startswith('gyrA_')]\n            par=[g for g in uncertain if g.startswith('parC_')]\n            if len(gyr)>=2 or (gyr and par): hits=uncertain; uncertain=[]\n        if drug=='trimethoprim/sulfamethoxazole':\n            # Require evidence affecting both components; one alone is indeterminate.\n            trim=any('TRIMETHOPRIM' in r['Subclass'] for r in good)\n            sul=any('SULFONAMIDE' in r['Subclass'] for r in good)\n            if hits and not (trim and sul): uncertain=hits; hits=[]\n        if hits: prediction='R'; evidence='; '.join(sorted(set(hits)))\n        elif uncertain: prediction='NA'; evidence='; '.join(sorted(set(uncertain)))+'; insufficient for binary phenotype call'\n        else: prediction='S'; evidence='no determinant found'\n        all_calls.append([isolate,drug,prediction,evidence])\nwith open('output/predictions.tsv','w') as f:\n    w=csv.writer(f,delimiter='\\\\t',lineterminator='\\\\n'); w.writerow(['isolate_id','antibiotic','prediction','evidence']); w.writerows(all_calls)\nassert len(all_calls)==len(list(Path('data/genomes').glob('*.fasta')))*len(antibiotics)\nassert len({tuple(r[:2]) for r in all_calls})==len(all_calls)\nprint(f'Validated {len(all_calls)} unique predictions')\nPY\"", "exit_code": 0, "stdout": "", "stderr": "", "tool": "command_execution", "source": "events.jsonl", "call_id": "item_20", "key_path": "item", "batch": "batch_006"}
