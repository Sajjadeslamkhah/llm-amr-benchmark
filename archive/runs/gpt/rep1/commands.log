{"cmd": "/bin/zsh -lc \"cat > output/make_predictions.py <<'PY'\n#\"'!/usr/bin/env python3\n\"\"\"Translate the retained AMRFinder results using the rules in methods.md.\"\"\"\nimport csv\nfrom pathlib import Path\nantibiotics=Path('\"'data/antibiotics.txt').read_text().splitlines()\nrecords=[]\nfor fasta in sorted(Path('data/genomes').glob('*.fasta')):\n    isolate=fasta.stem\n    with Path(f'output/amrfinder/{isolate}.tsv').open() as f:\n        hits=list(csv.DictReader(f,delimiter='\\\\t'))\n    # Keep near-full-length genes and the curated resistance mutation report.\n    hits=[h for h in hits if float(h['% Coverage of reference'])>=90 and h['Method'] not in ('INTERNAL_STOP','PARTIAL')]\n    for drug in antibiotics:\n        selected=[]; prediction='S'; evidence='no determinant found'\n        if drug=='ampicillin':\n            selected=[h for h in hits if h['Element symbol'].startswith('bla') or h['Element symbol'].startswith('ampC_') or 'AMPICILLIN' in h['Subclass'].split('/')]\n        elif drug=='cefotaxime':\n            selected=[h for h in hits if h['Element symbol'].startswith(('blaCTX-M','blaCMY','blaDHA','blaFOX','blaACC','blaACT','blaMIR','blaLAT','blaMOX','blaKPC','blaNDM','blaVIM','blaIMP','blaGES')) or h['Element symbol'].startswith('ampC_') or ('extended-spectrum' in h['Element name'].lower() and h['Element symbol'].startswith('bla'))]\n        elif drug=='meropenem':\n            selected=[h for h in hits if 'CARBAPENEM' in h['Subclass'] or h['Element symbol'].startswith(('blaKPC','blaNDM','blaVIM','blaIMP','blaOXA-48','blaOXA-181','blaOXA-232','blaOXA-244'))]\n        elif drug=='gentamicin':\n            selected=[h for h in hits if 'GENTAMICIN' in h['Subclass'].split('/') or h['Element symbol'].startswith(('armA','rmt','npmA'))]\n        elif drug=='ciprofloxacin':\n            target=[h for h in hits if h['Element symbol'].startswith(('gyrA_','gyrB_','parC_','parE_')) and 'QUINOLONE' in h['Subclass']]\n            major=[h for h in target if h['Element symbol'].startswith(('gyrA_','gyrB_'))]\n            if major:\n                selected=target+[h for h in hits if h['Element symbol'].startswith(('qnr','aac(6\\\\')-Ib-cr','qepA','oqx'))]\n            else:\n                low=[h for h in hits if 'QUINOLONE' in h['Subclass']]\n                if low:\n                    prediction='NA'; evidence='; '.join(sorted({h['Element symbol'] for h in low}))+': low-level/isolated mechanism; breakpoint resistance uncertain'\n        elif drug=='trimethoprim/sulfamethoxazole':\n            dfr=[h for h in hits if 'TRIMETHOPRIM' in h['Subclass'].split('/')]\n            sul=[h for h in hits if 'SULFONAMIDE' in h['Subclass'].split('/')]\n            if dfr and sul:\n                selected=dfr+sul\n            elif dfr or sul:\n                prediction='NA'; evidence='; '.join(sorted({h['Element symbol'] for h in dfr+sul}))+': only one combination component; phenotype uncertain'\n        else:\n            raise ValueError(drug)\n        if selected:\n            prediction='R'; evidence='; '.join(sorted({h['Element symbol'] for h in selected}))\n        records.append([isolate,drug,prediction,evidence])\nwith Path('output/predictions.tsv').open('w') as f:\n    writer=csv.writer(f,delimiter='\\\\t',lineterminator='\\\\n')\n    writer.writerow(['isolate_id','antibiotic','prediction','evidence'])\n    writer.writerows(records)\nassert len(records)==len(list(Path('data/genomes').glob('*.fasta')))*len(antibiotics)\nassert len({(r[0],r[1]) for r in records})==len(records)\nprint(f'Wrote {len(records)} predictions')\nPY\"", "exit_code": 0, "stdout": "", "stderr": "", "tool": "command_execution", "source": "events.jsonl", "call_id": "item_18", "key_path": "item", "batch": "batch_008"}
