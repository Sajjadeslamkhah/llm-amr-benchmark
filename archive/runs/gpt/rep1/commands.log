{"cmd": "/bin/zsh -lc \"cat > output/make_predictions.py <<'PY'\nimport csv\nfrom pathlib import Path\nroot=Path(__file__).resolve().parent\nantibiotics=Path('data/antibiotics.txt').read_text().splitlines()\nallrows=[]\nfor fasta in sorted(Path('data/genomes').glob('*.fasta')):\n    rows=list(csv.DictReader((root/'amrfinder'/f'{fasta.stem}.tsv').open(),delimiter='\\\\t'))\n    # Require substantial reference coverage for acquired genes.\n    genes=[r for r in rows if r['Subtype']=='AMR' and float(r['% Coverage of reference'])>=90 and r['Method'] not in ('PARTIALX','PARTIAL_CONTIG_ENDX')]\n    points=[r for r in rows if r['Subtype']=='POINT']\n    symbols=[r['Element symbol'] for r in genes]\n    determinants={a:[] for a in antibiotics}\n    for r in genes:\n        g=r['Element symbol']; name=r['Element name'].lower(); sub=r['Subclass']\n        if g.startswith('bla'):\n            determinants['ampicillin'].append(g)\n            if ('extended-spectrum' in name or 'cephalosporin-hydrolyzing class c' in name or g.startswith(('blaCMY','blaDHA','blaFOX','blaACC','blaACT','blaMIR','blaLAT','blaMOX')) or 'carbapenem' in name):\n                determinants['cefotaxime'].append(g)\n            if 'carbapenem' in name or g.startswith(('blaKPC','blaNDM','blaVIM','blaIMP','blaOXA-48','blaOXA-181','blaOXA-232')):\n                determinants['meropenem'].append(g)\n        if 'GENTAMICIN' in sub.split('/'):\n            determinants['gentamicin'].append(g)\n    qr=[r['Element symbol'] for r in points if r['Element symbol'].startswith(('gyrA_','parC_','parE_','gyrB_')) and 'QUINOLONE' in r['Class']]\n    # Multiple target alterations confer a robust ciprofloxacin resistance call.\n    if any(g.startswith('gyrA_') for g in qr) and (len([g for g in qr if g.startswith('gyrA_')])>=2 or any(g.startswith('parC_') for g in qr)):\n        determinants['ciprofloxacin']=qr+[g for g in symbols if g.startswith(('qnr','aac(6\\\\')-Ib-cr','qepA','oqx'))]\n    dfr=[g for g in symbols if g.startswith('dfr')]\n    sul=[g for g in symbols if g.startswith('sul')]\n    if dfr and sul: determinants['trimethoprim/sulfamethoxazole']=dfr+sul\n    for a in antibiotics:\n        hits=sorted(set(determinants[a]))\n        pred='R' if hits else 'S'; evidence='; '.join(hits) if hits else 'no determinant found'\n        if a=='ciprofloxacin' and not hits:\n            low=qr+[g for g in symbols if g.startswith(('qnr','aac(6\\\\')-Ib-cr','qepA','oqx'))]\n            if low: pred='NA'; evidence='; '.join(low)+'; resistance level uncertain'\n        if a=='trimethoprim/sulfamethoxazole' and not hits and (dfr or sul):\n            pred='NA'; evidence='; '.join(dfr+sul)+'; only one component supported'\n        allrows.append([fasta.stem,a,pred,evidence])\nwith (root/'predictions.tsv').open('w') as f:\n    w=csv.writer(f,delimiter='\\\\t',lineterminator='\\\\n'); w.writerow(['isolate_id','antibiotic','prediction','evidence']); w.writerows(allrows)\nassert len(allrows)==60\nPY\"", "exit_code": 0, "stdout": "", "stderr": "", "tool": "command_execution", "source": "events.jsonl", "call_id": "item_17", "key_path": "item", "batch": "batch_005"}
