{"cmd": "/bin/zsh -lc \"python - <<'PY'\nfrom pathlib import Path\nimport hashlib,csv\nwith open('output/assembly_qc.tsv','w') as f:\n w=csv.writer(f,delimiter='\\\\t',lineterminator='\\\\n');w.writerow(['isolate_id','contigs','bases','N_bases','sha256'])\n for p in sorted(Path('data/genomes').glob('*.fasta')):\n  raw=p.read_bytes(); lines=raw.decode().splitlines();seq=''.join(l.strip() for l in lines if not l.startswith('>')).upper()\n  row=[p.stem,sum(l.startswith('>') for l in lines),len(seq),seq.count('N'),hashlib.sha256(raw).hexdigest()];w.writerow(row);print(*row[:4])\nPY\"", "exit_code": 0, "stdout": "ISO_101 88 5026553 0\nISO_102 114 5076372 0\nISO_103 251 5056841 0\nISO_104 152 5067144 0\nISO_105 101 5095948 0\nISO_106 60 5036940 0\nISO_107 138 4999663 0\nISO_108 171 5024696 0\nISO_109 126 5198514 0\nISO_110 265 5336650 0\n", "stderr": "", "tool": "command_execution", "source": "events.jsonl", "call_id": "item_18", "key_path": "item", "batch": "batch_011"}
