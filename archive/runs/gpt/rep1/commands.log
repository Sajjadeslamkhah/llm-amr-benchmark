{"cmd": "/bin/zsh -lc \"python3 - <<'PY'\nimport csv,pathlib\nfor p in sorted(pathlib.Path('output/amrfinder').glob('ISO_*.tsv')):\n if '.mutations.' in p.name: continue\n rows=list(csv.DictReader(p.open(),delimiter='\\\\t'))\n print(p.stem,[(r['Element symbol'],r['Subclass'],r['% Coverage of reference']) for r in rows])\nPY\"", "exit_code": 0, "stdout": "ISO_011 [('aadA1', 'STREPTOMYCIN', '100.00'), ('blaOXA-10', 'CEPHALOSPORIN', '100.00'), ('cmlA5', 'CHLORAMPHENICOL', '100.00'), ('arr-2', 'RIFAMYCIN', '100.00'), ('sul3', 'SULFONAMIDE', '100.00'), ('blaTEM-1', 'BETA-LACTAM', '100.00'), ('tet(A)', 'TETRACYCLINE', '100.00'), ('qnrS1', 'QUINOLONE', '100.00'), ('floR', 'CHLORAMPHENICOL/FLORFENICOL', '100.00'), ('dfrA14', 'TRIMETHOPRIM', '100.00'), ('gyrA_S83L', 'QUINOLONE', '99.66'), (\"aph(3')-Ia\", 'KANAMYCIN', '100.00')]\nISO_012 [('blaOXA-48', 'CARBAPENEM', '100.00')]\nISO_013 [('nfsA_Q195Ter', 'NITROFURANTOIN', '100.00'), ('parC_S80I', 'QUINOLONE', '100.00'), ('parE_S458A', 'QUINOLONE', '100.00'), ('tet(A)', 'TETRACYCLINE', '100.00'), ('aph(4)-Ia', 'HYGROMYCIN', '78.59'), ('aac(3)-IVa', 'APRAMYCIN/GENTAMICIN/TOBRAMYCIN', '100.00'), (\"aph(3')-Ia\", 'KANAMYCIN', '100.00'), ('ble', 'BLEOMYCIN', '100.00'), ('blaNDM-5', 'CARBAPENEM', '100.00'), ('qacEdelta1', 'QUATERNARY AMMONIUM', '100.00'), ('aadA2', 'STREPTOMYCIN', '100.00'), ('dfrA12', 'TRIMETHOPRIM', '100.00'), ('floR', 'CHLORAMPHENICOL/FLORFENICOL', '100.00'), ('sul2', 'SULFONAMIDE', '100.00'), ('ftsI_N337NYRIN', 'AZTREONAM/CEFIDEROCOL/CEPHALOSPORIN', '100.00'), ('acrR_T5N', 'AMPICILLIN/CHLORAMPHENICOL/FLUOROQUINOLONE/RIFAMPIN/TETRACYCLINE', '100.00'), ('blaCTX-M-14', 'CEPHALOSPORIN', '100.00'), ('fosA3', 'FOSFOMYCIN', '100.00'), ('ompF_D34RfsTer1', 'CARBAPENEM', '100.00'), ('mrx(A)', 'AZITHROMYCIN/ERYTHROMYCIN/SPIRAMYCIN/TELITHROMYCIN', '100.00'), ('mph(A)', 'AZITHROMYCIN/ERYTHROMYCIN/SPIRAMYCIN/TELITHROMYCIN', '100.00'), ('cirA_E297Ter', 'CEFIDEROCOL', '100.00'), ('gyrA_D87N', 'QUINOLONE', '99.66'), ('gyrA_S83