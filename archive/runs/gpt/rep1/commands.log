{"cmd": "/bin/zsh -lc \"cat > output/make_predictions.py <<'PY'\nimport csv\nfrom pathlib import Path\nantibiotics=Path('data/antibiotics.txt').read_text().splitlines()\nrows=[]\nfor fasta in sorted(Path('data/genomes').glob('*.fasta')):\n    isolate=fasta.stem\n    report=Path('output/amrfinder')/(isolate+'.tsv')\n    hits=list(csv.DictReader(report.open(),delimiter='\\\\t'))\n    genes={r['Element symbol'] for r in hits if float(r['% Coverage of reference'])>=90 and float(r['% Identity to reference'])>=90}\n    for antibiotic in antibiotics:\n        drivers=[]\n        if antibiotic=='ampicillin':\n            drivers=sorted(g for g in genes if g.startswith(('blaTEM','blaCTX-M')))\n        elif antibiotic=='cefotaxime':\n            drivers=sorted(g for g in genes if g.startswith('blaCTX-M'))\n        elif antibiotic=='ciprofloxacin':\n            drivers=sorted(g for g in genes if g.startswith(('gyrA_S83','gyrA_D87','parC_S80','parC_E84')))\n        elif antibiotic=='gentamicin':\n            drivers=sorted(g for g in genes if g.startswith(('aac(3)-','aac(6\\\\')-Ie/aph(2\\\\'\\\\')','armA','rmt')))\n        elif antibiotic=='meropenem':\n            drivers=sorted(g for g in genes if g.startswith(('blaKPC','blaNDM','blaVIM','blaIMP','blaOXA-48','blaOXA-181','blaOXA-232')))\n        elif antibiotic=='trimethoprim/sulfamethoxazole':\n            dfr=sorted(g for g in genes if g.startswith('dfr'))\n            sul=sorted(g for g in genes if g.startswith('sul'))\n            if dfr: drivers=dfr+sul\n        evidence='; '.join(drivers) if drivers else 'no determinant found'\n        if antibiotic=='trimethoprim/sulfamethoxazole' and not drivers:\n            sul=sorted(g for g in genes if g.startswith('sul'))\n            if sul: evidence='; '.join(sul)+' only; no trimethoprim determinant found'\n        rows.append([isolate,antibiotic,'R' if drivers else 'S',evidence])\nwith open('output/predictions.tsv','w') as out:\n    writer=csv.writer(out,delimiter='\\\\t',lineterminator='\\\\n')\n    writer.writerow(['isolate_id','antibiotic','prediction','evidence'])\n    writer.writerows(rows)\nassert len(rows)==len(list(Path('data/genomes').glob('*.fasta')))*len(antibiotics)\nassert len({tuple(r[:2]) for r in rows})==len(rows)\nprint('Validated',len(rows),'unique isolate-antibiotic predictions')\nPY\"", "exit_code": 0, "stdout": "", "stderr": "", "tool": "command_execution", "source": "events.jsonl", "call_id": "item_19", "key_path": "item", "batch": "batch_010"}
