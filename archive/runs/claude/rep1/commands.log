{"cmd": "mkdir -p output/scripts && cat > output/scripts/call.py <<'EOF'\nimport csv, glob, os, re, sys\nabx = [l.strip() for l in open(\"data/antibiotics.txt\") if l.strip()]\nout = open(\"output/predictions.tsv\", \"w\")\nout.write(\"isolate_id\\tantibiotic\\tprediction\\tevidence\\n\")\nfor f in sorted(glob.glob(\"output/amrfinder/ISO_*.tsv\")):\n    iso = os.path.basename(f)[:-4]\n    rows = [r for r in csv.DictReader(open(f), delimiter=\"\\t\") if r[\"Type\"] == \"AMR\"]\n    g = [r[\"Element symbol\"] for r in rows]\n    def has(p): return [x for x in g if re.match(p, x)]\n    # beta-lactams (blaEC = intrinsic chromosomal ampC, ignored unless promoter mutation)\n    ampc_prom = has(r\"^(ampC|blaEC)_.*[cC]?-?\\d+|^blaECp\")  # promoter/attenuator point mutations\n    esbl = has(r\"^bla(CTX-M|SHV-(?!1$|11$)|VEB|PER|GES|TEM-(?!1$))\")\n    pampc = has(r\"^bla(CMY|DHA|ACC|FOX|MOX|ACT|MIR|LAT)\")\n    carb = has(r\"^bla(KPC|NDM|VIM|IMP|OXA-48|OXA-181|OXA-232|OXA-244|OXA-162|OXA-204)\")\n    pen = [x for x in has(r\"^bla\") if not x.startswith(\"blaEC\")]\n    cefo = esbl + pampc + carb + ampc_prom\n    qrdr = has(r\"^(gyrA|gyrB|parC|parE)_\")\n    gyra = has(r\"^gyrA_(S83|D87)\")\n    pmqr = has(r\"^(qnr|aac\\(6'\\)-Ib-cr|qepA|oqx)\")\n    gen = has(r\"^(aac\\(3\\)|aac\\(6'\\)-Ib'|aac\\(6'\\)-Ib\\b|ant\\(2''\\)|armA|rmt|npmA|aac\\(6'\\)-Ib-cr)\")\n    gen = [x for x in gen if not x.startswith(\"aac(6')-Ib-cr\")]\n    dfr = has(r\"^dfr\"); sul = has(r\"^sul\")\n    calls = {}\n    calls[\"ampicillin\"] = (\"R\", \"+\".join(pen)) if pen else (\"S\", \"no acquired beta-lactamase (intrinsic blaEC only)\")\n    calls[\"cefotaxime\"] = (\"R\", \"+\".join(cefo)) if cefo else (\"S\", \"no ESBL/AmpC/carbapenemase\" + (f\" ({'+'.join(pen)} narrow-spectrum only)\" if pen else \"\"))\n    nq = len(set(qrdr))\n    if (gyra and nq >= 2) or (gyra and pmqr):\n        calls[\"ciprofloxacin\"] = (\"R\", \"+\".join(qrdr + pmqr))\n    elif qrdr or pmqr:\n        calls[\"ciprofloxacin\"] = (\"S\", \"+\".join(qrdr + pmqr) + \" only; single determinant predicted below R breakpoint\")\n    else:\n        calls[\"ciprofloxacin\"] = (\"S\", \"no determinant found\")\n    calls[\"gentamicin\"] = (\"R\", \"+\".join(gen)) if gen else (\"S\", \"no gentamicin-modifying enzyme/16S methylase\")\n    calls[\"meropenem\"] = (\"R\", \"+\".join(carb)) if carb else (\"S\", \"no carbapenemase\" + (f\" ({'+'.join(has(r'^omp'))} porin change without carbapenemase)\" if has(r'^omp') else \"\"))\n    if dfr:\n        calls[\"trimethoprim/sulfamethoxazole\"] = (\"R\", \"+\".join(dfr + sul) + (\"\" if sul else \" (dfr without sul)\"))\n    else:\n        calls[\"trimethoprim/sulfamethoxazole\"] = (\"S\", (\"+\".join(sul) + \" without dfr\") if sul else \"no determinant found\")\n    for a in abx:\n        p, e = calls.get(a, (\"NA\", \"antibiotic not handled\"))\n        out.write(f\"{iso}\\t{a}\\t{p}\\t{e}\\n\")\nEOF\npython3 -I output/scripts/call.py && column -t -s$'\\t' output/predictions.tsv", "exit_code": 0, "stdout": "isolate_id  antibiotic                     prediction  evidence\nISO_061     ampicillin                     R           blaCMY-111+blaTEM-1\nISO_061     cefotaxime                     R           blaCMY-111\nISO_061     ciprofloxacin                  S           no determinant found\nISO_061     gentamicin                     S           no gentamicin-modifying enzyme/16S methylase\nISO_061     meropenem                      S           no carbapenemase\nISO_061     trimethoprim/sulfamethoxazole  R           dfrA12+sul3\nISO_062     ampicillin                     R           blaTEM-1\nISO_062     cefotaxime                     S           no ESBL/AmpC/carbapenemase (blaTEM-1 narrow-spectrum only)\nISO_062     ciprofloxacin                  S           no determinant found\nISO_062     gentamicin                     S           no gentamicin-modifying enzyme/16S methylase\nISO_062     meropenem                      S           no carbapenemase\nISO_0